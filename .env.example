# Udacity AgentCore project environment values.
# Copy this file to .env and fill in the values created during setup.
# Do not put AWS access keys or session tokens in this file.

# AWS settings
AWS_REGION=us-east-1
PROJECT_NAME=udacity-agentcore

# Bedrock Knowledge Base IDs
# Returns uses the S3 prefix policies/returns/
# Shipping uses the S3 prefix policies/shipping/
# Warranty uses the S3 prefix policies/warranty/
RETURNS_KB_ID=
SHIPPING_KB_ID=
WARRANTY_KB_ID=

# AgentCore Runtime
AGENTCORE_RUNTIME_ARN=

# Bedrock Guardrail
GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT
